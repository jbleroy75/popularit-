{
  // Site statique EffaceMoi servi par Cloudflare Workers (dossier dist/).
  "name": "effacemoi",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "effacemoi.jbleroy.fr", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
